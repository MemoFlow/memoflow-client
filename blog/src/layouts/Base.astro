---
import { SITE } from '../site';
import { breadcrumbList, type Crumb } from '../schema';
import PostHog from '../components/posthog.astro';
import '../blog.css';

interface Props {
  title: string;
  description: string;
  path: string;
  noindex?: boolean;
  ogType?: 'website' | 'article';
  crumbs?: Crumb[];
  /** Nœuds JSON-LD de la page ; le BreadcrumbList est ajouté depuis crumbs */
  graph?: object[];
}

const { title, description, path, noindex = false, ogType = 'website', crumbs = [], graph = [] } = Astro.props;
const canonical = `${SITE}${path}`;
const nodes = crumbs.length > 1 ? [...graph, breadcrumbList(crumbs)] : graph;
// < : empêche une chaîne du contenu de fermer la balise script
const jsonLd = JSON.stringify({ '@context': 'https://schema.org', '@graph': nodes }).replace(/</g, '\\u003c');
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="MemoFlow" />
    <meta property="og:locale" content="fr_FR" />
    {nodes.length > 0 && <script type="application/ld+json" set:html={jsonLd} />}
    <PostHog />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href="/blog/">MemoFlow <span>Blog</span></a>
      </div>
    </header>
    <main class="wrap">
      {crumbs.length > 1 && (
        <nav class="crumbs" aria-label="Fil d'Ariane">
          <ol>
            {crumbs.map((c, i) =>
              i < crumbs.length - 1 ? <li><a href={c.path}>{c.name}</a></li> : <li aria-current="page">{c.name}</li>
            )}
          </ol>
        </nav>
      )}
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <a href="/blog/">Accueil du blog</a>
        <a href="/blog/auteur/francois-hatem/">L'auteur</a>
        <button type="button" class="lien-consent" id="consent-open">Mesure d'audience</button>
        <span>© MemoFlow</span>
      </div>
    </footer>
    <!-- Mesure d'audience : mêmes textes et même clé que src/components/ConsentBanner.tsx.
         Caché sans JS ; le script l'affiche tant que le visiteur n'a pas choisi. -->
    <div class="consent" id="consent" role="region" aria-label="Mesure d'audience" hidden>
      <div class="consent-texte">
        <p class="consent-titre">Mesure d'audience</p>
        <p>
          Avec votre accord, nous utilisons Google Analytics et PostHog pour savoir quelles pages sont consultées et
          améliorer MemoFlow. PostHog peut aussi enregistrer le déroulé de la visite (clics, défilement), sans ce que vous
          saisissez dans les champs. Rien n'est déposé ni envoyé si vous refusez. Vous pouvez changer d'avis à tout
          moment avec le lien « Mesure d'audience » en bas de page ou dans les Paramètres de MemoFlow.
          <a href="/">En savoir plus</a>
        </p>
      </div>
      <div class="consent-choix">
        <button type="button" data-consent="denied">Refuser</button>
        <button type="button" data-consent="granted">Accepter</button>
      </div>
    </div>
    <!-- Même logique que src/services/analytics.ts (Consent Mode v2 basique) : rien n'est chargé avant l'accord.
         La clé localStorage est partagée avec l'app (même origine). PostHog (components/posthog.astro) lit la
         même clé et réagit aux mêmes boutons data-consent. -->
    <script is:inline>
      (function () {
        var KEY = 'memoflow_analytics_consent';
        var GTM_ID = 'GTM-KJR96BWV';
        window.dataLayer = window.dataLayer || [];
        function gtag() { window.dataLayer.push(arguments); }
        gtag('consent', 'default', {
          ad_storage: 'denied',
          ad_user_data: 'denied',
          ad_personalization: 'denied',
          analytics_storage: 'denied'
        });
        var loaded = false;
        function loadGtm() {
          if (loaded) return;
          loaded = true;
          gtag('consent', 'update', { analytics_storage: 'granted' });
          window.dataLayer.push({ 'gtm.start': Date.now(), event: 'gtm.js' });
          var s = document.createElement('script');
          s.async = true;
          s.src = 'https://www.googletagmanager.com/gtm.js?id=' + GTM_ID;
          document.head.appendChild(s);
        }
        function deleteGaCookies() {
          var host = location.hostname;
          document.cookie.split(';').forEach(function (c) {
            var name = c.split('=')[0].trim();
            if (name.indexOf('_ga') !== 0 && name.indexOf('_gid') !== 0) return;
            ['', host, '.' + host].forEach(function (d) {
              document.cookie = name + '=; expires=Thu, 01 Jan 1970 00:00:00 GMT; path=/' + (d ? '; domain=' + d : '');
            });
          });
        }
        var consent = null;
        try { consent = localStorage.getItem(KEY); } catch (e) {}
        var banner = document.getElementById('consent');

        banner.addEventListener('click', function (e) {
          var choice = e.target.getAttribute('data-consent');
          if (!choice) return;
          var previous = consent;
          consent = choice;
          try { localStorage.setItem(KEY, choice); } catch (err) {}
          banner.hidden = true;
          if (choice === 'granted') return loadGtm();
          deleteGaCookies();
          // Accord retiré : GTM et PostHog ne peuvent pas être déchargés, on recharge sans eux
          if (previous === 'granted') location.reload();
        });

        // Lien « Mesure d'audience » du pied de page : revoir ou retirer son choix à tout moment
        document.getElementById('consent-open').addEventListener('click', function () {
          banner.hidden = false;
        });

        if (consent === 'granted') return loadGtm();
        if (consent === 'denied') return deleteGaCookies();
        banner.hidden = false;
      })();
    </script>
  </body>
</html>
